@using ASP_NET_Core.Models
@model IEnumerable<Employee>

<script>
    let editCells = [];

    function onCellPrepared(e) {
        if (e.rowType === "data" && editCells.includes(`${e.rowIndex}:${e.columnIndex}`)) {
            e.cellElement.css("background-color", "lightblue");
        }
    }

    function onEditorPreparing(e) {
        const grid = e.component;
        if (e.parentType === "dataRow") {
            const oldOnValueChanged = e.editorOptions.onValueChanged;
            e.editorOptions.onValueChanged = function onValueChanged(args) {
                oldOnValueChanged.apply(this, [args]);
                editCells.forEach((cell) => {
                    const [rowIndex, columnIndex] = cell.split(":").map(Number);
                    grid.cellValue(rowIndex, columnIndex, args.value);
                });
            };
        }
    }

    function onCellClick(e) {
        if (e.event && e.event.ctrlKey) {
            editCells.push(`${e.rowIndex}:${e.columnIndex}`);
        } else if (editCells.length) {
            editCells = [];
            e.component.repaint();
        }
    }

    function resetEditCells() {
        editCells = [];
    }
</script>

@(Html.DevExtreme().DataGrid<Employee>()
    .ID("gridContainer")
    .DataSource(Model)
    .KeyExpr("ID")
    .Paging(p => p.Enabled(false))
    .Editing(editing => {
        editing.Mode(GridEditMode.Batch);
        editing.AllowUpdating(true);
    })
    .Columns(columns => {
        columns.Add().DataField("Prefix").Caption("Title").Width(70);
        columns.Add().DataField("FirstName");
        columns.Add().DataField("LastName");
        columns.Add().DataField("Position").Width(170);
        columns.Add().DataField("StateID").Caption("State").Width(125)
            .Lookup(lookup => lookup
                .DataSource(State.States)
                .DisplayExpr("Name")
                .ValueExpr("ID")
            );
    })
    .OnCellPrepared("onCellPrepared")
    .OnEditorPreparing("onEditorPreparing")
    .OnCellClick("onCellClick")
    .OnSaving("resetEditCells")
    .OnEditCanceled("resetEditCells")
)
